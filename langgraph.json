{
  "dependencies": [
    "."
  ],
  "env": ".env",
  "graphs": {
    "agent": "./langHar/graph_entry.py:graph"
  },
  "http": {
    "app": "./langHar/main.py:app",
    "cors": {
      "allow_origins": [
        "https://smith.langchain.com"
      ],
      "allow_methods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "OPTIONS"
      ],
      "allow_headers": [
        "Content-Type",
        "Authorization",
        "X-Api-Key",
        "X-Auth-Scheme",
        "X-Mda-Channel",
        "X-Tenant-Id"
      ],
      "allow_credentials": true
    }
  }
}
