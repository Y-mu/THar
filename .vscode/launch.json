{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: 调试当前测试文件",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "args": ["-v"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "justMyCode": true
    },

  ]
  
}
