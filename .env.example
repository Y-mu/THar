# 应用入口：source env/bin/activate 后运行 langgraph dev，直接连接 Studio，无需登录。
# thread/checkpointer 由 LangGraph Server 管理。

# DeepSeek 负责生成回答和调用工具。
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# JEV / TypeSafe AI 只负责意图识别。
TYPESAFE_API_KEY=your-typesafe-api-key
# 也兼容变量名 JEV_API_KEY；两者同时存在时优先使用 TYPESAFE_API_KEY。
JEV_MODEL=jev-latest

# 低于该置信度时不执行任何 agent/tool，而是要求用户澄清。
INTENT_CONFIDENCE_THRESHOLD=0.55

# 本地 BGE 模型缺失或文件不完整时自动从 Hugging Face 下载。
# 设备自动选择 CUDA / MPS / CPU；MPS 需满足当前 PyTorch 的 macOS 版本要求。
RAG_EMBEDDING_MODEL_PATH=./models/bge-small-zh-v1.5
# 单一 default 知识库；仅支持 UTF-8 Markdown/TXT，目录查询不加载 Embedding。
RAG_PERSIST_DIRECTORY=./chroma_db
RAG_COLLECTION_NAME=rag_documents
